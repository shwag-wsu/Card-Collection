FROM node:20-bookworm-slim AS deps
WORKDIR /app

COPY apps/web/package.json apps/web/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

FROM node:20-bookworm-slim AS builder
WORKDIR /app

ARG APP_VERSION=dev
ARG GIT_SHA=dev
ARG BUILD_TIME=unknown
ARG ANALYZER_VERSION=opencv-rules-v1.0.0
ENV APP_VERSION=$APP_VERSION
ENV GIT_SHA=$GIT_SHA
ENV BUILD_TIME=$BUILD_TIME
ENV ANALYZER_VERSION=$ANALYZER_VERSION

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/. .
RUN npx prisma generate
RUN npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ARG APP_VERSION=dev
ARG GIT_SHA=dev
ARG BUILD_TIME=unknown
ARG ANALYZER_VERSION=opencv-rules-v1.0.0
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV APP_VERSION=$APP_VERSION
ENV GIT_SHA=$GIT_SHA
ENV BUILD_TIME=$BUILD_TIME
ENV ANALYZER_VERSION=$ANALYZER_VERSION

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/prisma ./prisma

# make the Prisma CLI available in the runtime container
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000
CMD ["sh", "-lc", "./node_modules/.bin/prisma migrate deploy --schema=/app/prisma/schema.prisma && node server.js"]
